# Build Forge runner (copy to /etc/buildforge-runner/runner.env; install.sh does this for you)

# Where the runner listens. Only the Jenkins server should be able to reach this port.
BF_RUNNER_LISTEN=0.0.0.0:8796
# Same value as BF_RUNNER_SECRET on the Jenkins side. Generate with: openssl rand -hex 32
BF_RUNNER_SECRET=

# How kiro-cli logs in on this headless instance (leave empty if the service user is already logged in).
# KIRO_API_KEY=

# BF_AGENT=buildforge-fixer
# BF_TIMEOUT=240            # seconds one Kiro turn may take (Opus is thorough; keep it generous)
# BF_MAX_PARALLEL=3         # failures analysed at the same time
# BF_MAX_ERROR_CHARS=16000
# BF_KIRO_BIN=kiro-cli      # install.sh writes the full path here when it finds it
