# Build Forge service on the Jenkins server. Installed to /etc/buildforge/buildforge.env (mode 600).

# Where the plugin reaches this service. Keep it on 127.0.0.1 when Jenkins runs on the same machine.
BF_LISTEN=127.0.0.1:8791
# Shared with the plugin (Manage Jenkins > System > Build Forge > Secret). install.sh generates it.
BF_SHARED_SECRET=

# The Build Forge runner on the Kiro instance (port 8796) and its secret (BF_RUNNER_SECRET in its runner.env).
BF_RUNNER_URL=http://<kiro-instance-private-ip>:8796
BF_RUNNER_SECRET=
# How long to wait for one Kiro analysis; keep it above BF_TIMEOUT on the runner.
BF_RUNNER_TIMEOUT=300

# Incident logs (one <ENTRY-ID>.md per failure + incidents.jsonl) and the database.
BF_LOG_DIR=/var/log/buildforge
BF_DATA_DIR=/var/lib/buildforge
# Delete incidents (and their log files) older than this many days. 0 keeps them forever.
BF_RETENTION_DAYS=365

# errors = send Kiro only the failing stage's output (default) | full = the end of the console log
BF_SEND=errors
BF_MAX_ERROR_CHARS=16000

# Teams alert (Workflows "Send webhook alerts to a channel" URL) for these categories, comma separated:
# application, infrastructure, configuration, dependency, test_failure, transient, unknown, or all.
TEAMS_WEBHOOK_URL=
BF_NOTIFY_ON=infrastructure

# Optional regular expressions on the job's full name (folder/job/branch).
BF_JOB_INCLUDE=
BF_JOB_EXCLUDE=
