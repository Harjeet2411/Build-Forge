# Build Forge service on the Jenkins server. Installed to /etc/buildforge/buildforge.env (mode 600).

# Where the plugin reaches this service. Keep it on 127.0.0.1 when Jenkins runs on the same machine.
BF_LISTEN=127.0.0.1:8791
# Shared with the plugin (Manage Jenkins > System > Build Forge > Secret). install.sh generates it.
BF_SHARED_SECRET=

# The Build Forge runner on the Kiro instance (port 8796) and its secret (BF_RUNNER_SECRET in its runner.env).
BF_RUNNER_URL=http://<kiro-instance-private-ip>:8796
BF_RUNNER_SECRET=
# How long to wait for one Kiro analysis; keep it above BF_TIMEOUT on the runner.
BF_RUNNER_TIMEOUT=300

# Incident logs (one <ENTRY-ID>.md per failure + incidents.jsonl) and the database.
BF_LOG_DIR=/var/log/buildforge
BF_DATA_DIR=/var/lib/buildforge
# Delete incidents (and their log files) older than this many days. 0 keeps them forever.
BF_RETENTION_DAYS=365

# errors = send Kiro only the failing stage's output (default) | full = the end of the console log
BF_SEND=errors
BF_MAX_ERROR_CHARS=16000

# Teams alert (Workflows "Send webhook alerts to a channel" URL) for these categories, comma separated:
# application, infrastructure, configuration, dependency, test_failure, transient, unknown, or all.
TEAMS_WEBHOOK_URL=
BF_NOTIFY_ON=infrastructure

# Optional regular expressions on the job's full name (folder/job/branch). They only decide which failures are sent to
# Kiro. Every failure is still recorded and shown on the dashboard (as "Excluded"), and can be analysed on request.
BF_JOB_INCLUDE=
BF_JOB_EXCLUDE=

# Solutions deck: reusable answers learned from Kiro's analyses.
#   off      = no deck
#   fallback = a card answers only when Kiro is unavailable (default)
#   first    = a strong match (approved cards only) answers before Kiro is asked
BF_DECK_MODE=fallback
BF_DECK_THRESHOLD=0.55          # similarity needed for a fallback answer (0-1)
BF_DECK_FIRST_THRESHOLD=0.85    # similarity needed in "first" mode
BF_DECK_MIN_SEEN=2              # a draft card is trusted once its error was seen this many times (approved cards: always)

# Alerts (the bell on the dashboard): a pipeline that failed MORE than N builds in a row, until a build goes green.
BF_ALERTS=on                    # off = no alerts
BF_ALERT_PROD_AFTER=3           # critical: a production pipeline
BF_ALERT_UAT_AFTER=5            # high: a UAT / staging pipeline
BF_ALERT_OTHER_AFTER=5          # low: any other pipeline
# Which pipelines are "production" or "UAT": regular expressions on the full name (folder/job/branch), case-insensitive.
# The defaults match the words prod, prd, production (not pre-prod) and uat, staging, stage, stg, preprod.
BF_ENV_PROD=
BF_ENV_UAT=
